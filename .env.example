# Path to the SQLite database file
DATABASE_URL=./data/toodle.db

# Public URL of the instance (required in production, used by adapter-node for CSRF checks and in mails)
ORIGIN=http://localhost:5173

# Host port for docker compose (bound to 127.0.0.1, Caddy proxies to it)
TOODLE_PORT=3100

# Outgoing mail (e.g. Brevo SMTP relay). Without SMTP_HOST, mails are printed to the console.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="toodle <noreply@toodle.lu>"

# Address search (Photon API, https://github.com/komoot/photon) – can point to a self-hosted instance
GEOCODER_URL=https://photon.komoot.io
