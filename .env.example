# Path to the SQLite database file
DATABASE_URL=./data/toodle.db

# Public URL of the instance (required in production, used by adapter-node for CSRF checks and in mails)
ORIGIN=http://localhost:5173

# Host port for docker compose (bound to 127.0.0.1, Caddy proxies to it)
TOODLE_PORT=3100

# Outgoing mail (e.g. Brevo SMTP relay). Without SMTP_HOST, mails are printed to the console.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="toodle <noreply@toodle.lu>"

# Address search (Photon API, https://github.com/komoot/photon) – can point to a self-hosted instance
GEOCODER_URL=https://photon.komoot.io

# Map tiles, proxied through toodle (visitors' IPs are not passed on) – can point to a self-hosted tile server
# TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Notification job (ride hints, reminders): seconds between runs, 0 = off
NOTIFY_INTERVAL=600

# Web push: keys are generated automatically and stored in the database.
# Set these only to pin them (e.g. when moving the instance). Generate with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@toodle.lu

# Optional OSRM server for real driving times (default: straight-line estimate)
# ROUTING_URL=http://127.0.0.1:5000
